// Schéma Prisma de la plateforme de pots connectés
// Intention: Définir les modèles et contraintes pour des requêtes efficaces et sûres
// Objectif: Minimiser les duplications et optimiser les accès fréquents via index ciblés
// Logique: Relations explicites, indexes sur jointures et series temporelles, unicité sur succès
// PostgreSQL datasource and Prisma Client generator
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Enums
enum PlantStatus {
  ACTIVE
  REMOVED
  DEAD
}

enum PlantType {
  DECORATIVE
  AROMATIQUE
  PARFUMEE
  COMESTIBLE
}

enum AlertType {
  WATER_NEEDED
  LIGHT_TOO_LOW
  LIGHT_TOO_HIGH
  BATTERY_LOW
  OFFLINE
  OTHER
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum PotFormat {
  SMALL
  MEDIUM
  LARGE
}
// Users of the platform
model User {
  id              String           @id @default(uuid())
  email           String           @unique
  username        String?          @unique
  avatarUrl       String?
  passwordHash    String
  emailVerified   Boolean          @default(false)
  tokenVersion    Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  settings        UserSettings?
  devices         Device[]
  bases           BaseDevice[]
  pushTokens      PushToken[]
  achievements    UserAchievement[]
}

// Per-user settings and preferences
model UserSettings {
  id                        String   @id @default(uuid())
  userId                    String   @unique
  displayName               String?
  avatarUrl                 String?
  language                  String?  // e.g. "fr", "en"
  timezone                  String?
  notificationsEmailEnabled Boolean  @default(true)
  notificationsPushEnabled  Boolean  @default(true)

  user                      User     @relation(fields: [userId], references: [id])
}

// Push notification token registrations
model PushToken {
  id         String   @id @default(uuid())
  userId     String
  deviceType String   // ANDROID, WEB, etc.
  token      String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
}

// IoT device representing a connected plant pot
model Device {
  id                String           @id @default(uuid())
  deviceUid         String           @unique
  deviceSecret      String
  ownerId           String?
  name              String
  lastSeenAt        DateTime?
  pairingCode       String?          @unique
  pairedAt          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  owner             User?            @relation(fields: [ownerId], references: [id])
  plantInstances    PlantInstance[]
  sensorReadings    SensorReading[]
  alerts            Alert[]

  @@index([ownerId])
}

// A planted plant instance on a device
model PlantInstance {
  id           String      @id @default(uuid())
  deviceId     String
  speciesId    Int         // Logical FK to plant species in separate wiki DB/schema
  nickname     String?
  plantedAt    DateTime
  status       PlantStatus
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  device       Device      @relation(fields: [deviceId], references: [id])
  currentBaseSlot BaseSlot? @relation("CurrentPlantSlot")
  alerts       Alert[]
  assignmentHistory SlotAssignmentHistory[]

  @@index([deviceId, status])
}

// Time-series measurements from a device's sensors
model SensorReading {
  id           String    @id @default(uuid())
  deviceId     String
  baseSlotId   String?
  timestamp    DateTime
  soilMoisture Float?
  lightLevel   Float?
  temperature  Float?
  airHumidity  Float?
  createdAt    DateTime  @default(now())

  device       Device    @relation(fields: [deviceId], references: [id])
  baseSlot     BaseSlot? @relation(fields: [baseSlotId], references: [id])

  @@index([deviceId, timestamp])
  @@index([baseSlotId, timestamp])
}

// Alerts generated by devices and optionally associated with a plant instance
model Alert {
  id               String        @id @default(uuid())
  deviceId         String
  baseSlotId       String?
  plantInstanceId  String?
  type             AlertType
  severity         AlertSeverity
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?

  device           Device        @relation(fields: [deviceId], references: [id])
  baseSlot         BaseSlot?     @relation(fields: [baseSlotId], references: [id])
  plantInstance    PlantInstance? @relation(fields: [plantInstanceId], references: [id])

  @@index([deviceId, resolvedAt])
  @@index([deviceId, type, resolvedAt])
  @@index([baseSlotId, resolvedAt])
}

// Dictionary of achievements available in the platform
model Achievement {
  id              Int              @id @default(autoincrement())
  code            String           @unique
  title           String
  description     String
  category        String?
  icon            String?
  createdAt       DateTime         @default(now())

  userAchievements UserAchievement[]
}

// Achievements unlocked by users
model UserAchievement {
  id             String       @id @default(uuid())
  userId         String
  achievementId  Int
  unlockedAt     DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id])
  achievement    Achievement  @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

model PlantSpecies {
  id               Int          @id @default(autoincrement())
  commonName       String       @unique
  code             String?      @unique
  latinName        String?
  descriptionShort String?
  imageUrl         String?
  type             PlantType    @default(DECORATIVE)

  care             PlantCare?
}

model PlantCare {
  id                        Int           @id @default(autoincrement())
  species                   PlantSpecies  @relation(fields: [speciesId], references: [id])
  speciesId                 Int           @unique

  minMoisture               Float?
  maxMoisture               Float?
  minLight                  Int?
  maxLight                  Int?
  wateringIntervalDays      Int?
  recommendedTemperatureMin Float?
  recommendedTemperatureMax Float?
  careTips                  String?
  plantingTips              String?
  maintenanceTips           String?
}

model BaseDevice {
  id          String   @id @default(uuid())
  baseUid     String   @unique
  pairingCode String?  @unique
  name        String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User     @relation(fields: [ownerId], references: [id])
  slots       BaseSlot[]

  @@index([ownerId])
}

model BaseSlot {
  id                      String     @id @default(uuid())
  baseId                  String
  slotIndex               Int
  potFormat               PotFormat  @default(SMALL)
  isActive                Boolean    @default(true)
  currentPlantInstanceId  String?    @unique
  updatedAt               DateTime   @updatedAt

  base                    BaseDevice @relation(fields: [baseId], references: [id])
  currentPlantInstance    PlantInstance? @relation("CurrentPlantSlot", fields: [currentPlantInstanceId], references: [id])
  readings                SensorReading[]
  alerts                  Alert[]
  assignments             SlotAssignmentHistory[]

  @@unique([baseId, slotIndex])
}

model SlotAssignmentHistory {
  id               String    @id @default(uuid())
  baseSlotId       String
  plantInstanceId  String
  assignedAt       DateTime  @default(now())
  unassignedAt     DateTime?

  slot             BaseSlot  @relation(fields: [baseSlotId], references: [id])
  plant            PlantInstance @relation(fields: [plantInstanceId], references: [id])

  @@index([baseSlotId, assignedAt])
  @@index([plantInstanceId, assignedAt])
}
